<Project>
  <!--
    Central package management for the .NET 11 / EF Core 11 side of the demo.
    Scenario files use "#:package Name" WITHOUT a version; the version comes from here.

    TODO (first thing to do): replace EfCoreVersion with a real EF Core 11 version.
    .NET 11 ships in November 2026; until then use the latest 11.0.0-rc.* build from nuget.org.
    The placeholder below is deliberately invalid so restore fails loudly instead of silently
    picking something else.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <NuGetAudit>false</NuGetAudit>
    <EfCoreVersion>11.0.0-rc.3.26522.148</EfCoreVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(EfCoreVersion)" />
  </ItemGroup>
</Project>
